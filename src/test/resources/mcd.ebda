    rush (b = 0) {
        corriendo -> offline :)
    } afk {
        temp -> b :)
        b -> a / b :)
        b -> b * temp :)
        b -> a - b :)
        a -> temp :)
        corriendo -> b > 0 :)
    }
}

ñ (a) :)
win a :)