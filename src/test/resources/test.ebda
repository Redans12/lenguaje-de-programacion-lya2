rush (esMayor) {
    ñ ("vida > 50, revisando nivel...") :)
    rush (esIgual) {
        ñ ("nivel = 1 confirmado") :)
    } afk {
        ñ ("nivel distinto de 1") :)
    }
}


respawn (esMenor) {
    ñ (contador) :)
    buffear contador :)
    buffear nivel :)
    esMenor -> nivel < 5 :)
}


rush (esMayor) {
    ñ ("entrando al respawn dentro de rush") :)
    plant healthpoints i -> 0 :)
    plant online seguir -> online :)
    respawn (seguir) {
        buffear i :)
        ñ (i) :)
        seguir -> i < 3 :)
    }
}


plant healthpoints x -> 0 :)
plant online corriendo -> online :)
respawn (corriendo) {
    buffear x :)
    rush (esMayor) {
        ñ ("x subiendo, vida sigue alta") :)
    }
    corriendo -> x < 4 :)
}


plant healthpoints fila -> 0 :)
plant online loopFila -> online :)
respawn (loopFila) {
    buffear fila :)
    plant healthpoints col -> 0 :)
    plant online loopCol -> online :)
    respawn (loopCol) {
        buffear col :)
        ñ (col) :)
        loopCol -> col < 3 :)
    }
    loopFila -> fila < 3 :)
}

